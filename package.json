{
  "name": "taverna",
  "version": "0.1.0",
  "description": "Vault-first project orchestrator",
  "type": "module",
  "bin": {
    "taverna": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "morning": "VAULT_PATH=${VAULT_PATH:-/home/jvcm/tmp} tsx src/cli.ts morning",
    "morning:dry": "VAULT_PATH=${VAULT_PATH:-/home/jvcm/tmp} tsx src/cli.ts morning --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
